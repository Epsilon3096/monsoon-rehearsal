{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monsoon:site:1",
  "title": "Monsoon site-data staging contract v1 — DRAFT pending operator acceptance",
  "description": "Structural schema only. monsoon.site_data adds relational, provenance-label, units, datum, connectivity, before/after and bounded-numeric checks. No valid import activates a model or establishes physical validation. Null means unknown and fails required hydraulic fields. Source URIs are inert references.",
  "x-monsoon-contract-status": "draft_pending_operator_acceptance",
  "x-monsoon-activation-allowed": false,
  "x-monsoon-payload-limit-bytes": 5242880,
  "x-monsoon-nesting-limit": 64,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Explicit UTC offset or Z required."
    },
    "cross_section": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "width_m",
            "height_m"
          ],
          "properties": {
            "shape": {
              "const": "open_rectangle"
            },
            "width_m": {
              "type": "number",
              "maximum": 1000000000000.0,
              "exclusiveMinimum": 0
            },
            "height_m": {
              "type": "number",
              "maximum": 1000000000000.0,
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "diameter_m"
          ],
          "properties": {
            "shape": {
              "const": "circular"
            },
            "diameter_m": {
              "type": "number",
              "maximum": 1000000000000.0,
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "bottom_width_m",
            "height_m",
            "left_slope_h_per_v",
            "right_slope_h_per_v"
          ],
          "properties": {
            "shape": {
              "const": "trapezoid"
            },
            "bottom_width_m": {
              "type": "number",
              "maximum": 1000000000000.0,
              "exclusiveMinimum": 0
            },
            "height_m": {
              "type": "number",
              "maximum": 1000000000000.0,
              "exclusiveMinimum": 0
            },
            "left_slope_h_per_v": {
              "type": "number",
              "maximum": 1000000000000.0,
              "minimum": 0
            },
            "right_slope_h_per_v": {
              "type": "number",
              "maximum": 1000000000000.0,
              "minimum": 0
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "uri",
        "sha256",
        "observed_at",
        "author",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "synthetic_fixture",
            "survey",
            "inspection",
            "engineering_approval"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "x_m",
        "y_m",
        "invert_m",
        "ground_m",
        "survey_source_id",
        "storage_stage_area",
        "designed_outlet_link_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "junction",
            "storage",
            "outfall"
          ]
        },
        "x_m": {
          "type": "number",
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0
        },
        "y_m": {
          "type": "number",
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0
        },
        "invert_m": {
          "type": "number",
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0
        },
        "ground_m": {
          "type": "number",
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0
        },
        "survey_source_id": {
          "$ref": "#/$defs/id"
        },
        "storage_stage_area": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stage_m",
                  "area_m2"
                ],
                "properties": {
                  "stage_m": {
                    "type": "number",
                    "maximum": 1000000000000.0,
                    "minimum": -1000000000000.0
                  },
                  "area_m2": {
                    "type": "number",
                    "maximum": 1000000000000.0,
                    "exclusiveMinimum": 0
                  }
                }
              },
              "minItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "designed_outlet_link_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "storage"
              }
            }
          },
          "then": {
            "properties": {
              "storage_stage_area": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "stage_m",
                    "area_m2"
                  ],
                  "properties": {
                    "stage_m": {
                      "type": "number",
                      "maximum": 1000000000000.0,
                      "minimum": -1000000000000.0
                    },
                    "area_m2": {
                      "type": "number",
                      "maximum": 1000000000000.0,
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "minItems": 2
              },
              "designed_outlet_link_id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "else": {
            "properties": {
              "storage_stage_area": {
                "type": "null"
              },
              "designed_outlet_link_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_node",
        "to_node",
        "length_m",
        "inlet_invert_m",
        "outlet_invert_m",
        "roughness_n",
        "cross_section",
        "survey_source_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from_node": {
          "$ref": "#/$defs/id"
        },
        "to_node": {
          "$ref": "#/$defs/id"
        },
        "length_m": {
          "type": "number",
          "maximum": 1000000000000.0,
          "exclusiveMinimum": 0
        },
        "inlet_invert_m": {
          "type": "number",
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0
        },
        "outlet_invert_m": {
          "type": "number",
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0
        },
        "roughness_n": {
          "type": "number",
          "maximum": 1000000000000.0,
          "exclusiveMinimum": 0
        },
        "cross_section": {
          "$ref": "#/$defs/cross_section"
        },
        "survey_source_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "asset_id",
        "before_cross_section",
        "after_cross_section",
        "before_source_id",
        "after_source_id",
        "approval",
        "nominal_seconds",
        "maximum_seconds",
        "prerequisites"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "$ref": "#/$defs/id"
        },
        "before_cross_section": {
          "$ref": "#/$defs/cross_section"
        },
        "after_cross_section": {
          "$ref": "#/$defs/cross_section"
        },
        "before_source_id": {
          "$ref": "#/$defs/id"
        },
        "after_source_id": {
          "$ref": "#/$defs/id"
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved",
            "reviewer",
            "reviewed_at",
            "source_id"
          ],
          "properties": {
            "approved": {
              "const": true
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "reviewed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "source_id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "nominal_seconds": {
          "type": "number",
          "maximum": 1000000000000.0,
          "exclusiveMinimum": 0
        },
        "maximum_seconds": {
          "type": "number",
          "maximum": 1000000000000.0,
          "exclusiveMinimum": 0
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "revision",
    "supersedes_sha256",
    "title",
    "evidence_kind",
    "contract_status",
    "created_at",
    "crs",
    "vertical_datum",
    "units",
    "sources",
    "nodes",
    "links",
    "jobs",
    "boundaries",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "monsoon.site/1"
    },
    "site_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "$ref": "#/$defs/id"
    },
    "supersedes_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "evidence_kind": {
      "enum": [
        "synthetic_fixture",
        "supplied_survey"
      ]
    },
    "contract_status": {
      "const": "draft_pending_operator_acceptance"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "crs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "definition",
        "axis_order",
        "horizontal_unit"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "axis_order": {
          "const": "easting_northing"
        },
        "horizontal_unit": {
          "const": "m"
        }
      }
    },
    "vertical_datum": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "const": {
        "length": "m",
        "area": "m2",
        "volume": "m3",
        "flow": "m3/s",
        "time": "s",
        "roughness": "s/m^(1/3)"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 2
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      },
      "minItems": 1
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/job"
      },
      "minItems": 0
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inflow_node_ids",
        "outfall_node_ids",
        "spill_node_ids",
        "inventory_source_id"
      ],
      "properties": {
        "inflow_node_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "outfall_node_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "spill_node_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "inventory_source_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
